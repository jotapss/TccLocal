# === DATABASE ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinela
DB_USERNAME=sentinela_user
DB_PASSWORD=changeme_strong_password

# === JWT ===
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_256_bit_base64_secret_at_least_64_chars_long_for_security
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# === HMAC ===
# Shared secret with the Node.js agent — must match HMAC_SECRET in the agent config
HMAC_SECRET=replace_with_strong_hmac_secret_shared_with_agent

# === JASYPT ===
# Used to encrypt sensitive values in application.properties
# Set via environment variable or JVM arg: -Djasypt.encryptor.password=<value>
JASYPT_ENCRYPTOR_PASSWORD=replace_with_jasypt_master_password

# === RSA KEYS ===
# Place private_key.pem and public_key.pem in src/main/resources/keys/
# Generate with:
#   openssl genrsa -out private_key.pem 4096
#   openssl rsa -in private_key.pem -pubout -out public_key.pem

# === ADMIN USER ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@changeme123
ADMIN_RESET_PASSWORD=false

# === RATE LIMITING ===
RATE_LIMIT_PER_MINUTE=100

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
